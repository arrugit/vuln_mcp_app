# vuln_mcp_app configuration (TDD §26). NO real secrets — synthetic only (SEC-002).
# Copy to .env before `docker compose up`:  cp .env.example .env

APP_ENV=local
BIND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# SQLite file (re-seedable for reset, RST-001).
DATABASE_URL=sqlite:///./data/vuln_mcp.db

# MCP plane (D-03 streamable HTTP is the production target; Phase 0 uses an
# in-process registry transport in the backend).
MCP_SERVER_URL=http://mcp-server:9000
MCP_TRANSPORT=streamable-http
MCP_MODE=secure                # vulnerable | secure (global default; per-lab override in DB)

# Sandbox plane (MCP05 only; internal network, no egress).
SANDBOX_URL=http://sandbox:9100
SANDBOX_TIMEOUT_SECONDS=5

# Optional local LLM — never required for any vulnerability's core effect (NFR-001).
ENABLE_LOCAL_LLM=false
OLLAMA_URL=http://ollama:11434

# Synthetic placeholder secret only (SEC-002).
DEMO_SECRET_A=DEMO_SECRET_A

# D-05: set false to hide the env mode from /api/health for stricter black-box runs.
EXPOSE_HEALTH_MODE=true
