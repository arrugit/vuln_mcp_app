# vuln_mcp_app configuration (Docker-free local run). NO real secrets —
# synthetic only (SEC-002). Copy to .env (optional; sane defaults work):
#   cp .env.example .env

APP_ENV=local
BIND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# SQLite file (re-seedable for reset, RST-001). Relative to the repo root.
DATABASE_URL=sqlite:///./backend/data/vuln_mcp.db

# MCP plane. Phase 0 uses an in-process registry transport (single process), so
# these are informational until the streamable-HTTP transport is wired.
MCP_TRANSPORT=streamable-http
MCP_MODE=secure                # vulnerable | secure (global default; per-lab override in DB)

# Sandbox (MCP05 only; implemented later as a constrained in-process subprocess
# runner — see sandbox/README.md). Timeout guards the run.
SANDBOX_TIMEOUT_SECONDS=5

# Optional local LLM — never required for any vulnerability's core effect (NFR-001).
# Set true (and run Ollama) to enable the MCP03 "Live LLM demo" (indirect prompt
# injection against a real model). The deterministic labs work regardless.
ENABLE_LOCAL_LLM=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Synthetic placeholder secret only (SEC-002).
DEMO_SECRET_A=DEMO_SECRET_A

# D-05: set false to hide the env mode from /api/health for stricter black-box runs.
EXPOSE_HEALTH_MODE=true
